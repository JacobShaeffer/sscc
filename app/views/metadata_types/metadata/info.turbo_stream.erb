<%= turbo_stream.replace dom_id(@metadatum) do %>
  <div class="list-group-item" id="<%= dom_id @metadatum %>">
    <div class="mb-2 d-flex justify-content-between">
      <h5 class="mb-0"><%= @metadatum.name %> -- id: <%= @metadatum.id %></h5>
    </div>

    <div class="row g-2 mb-3">

      <div class="col-12 col-md-4">
        <div class="card">
          <div class="card-body p-2">
            <div class="d-flex justify-content-between">
              <div class="text-muted small">Usage</div>
              <div class="fw-bold">
                <%= @usage_count %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card">
          <div class="card-body p-2">
            <div class="d-flex justify-content-between">
              <div class="text-muted small">Added by</div>
              <div class="fw-bold">
                <%= @added_by %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
				<% reviewed_button_class = "btn me-2 " + (@reviewed == "reviewed" ? "btn-success" : "btn-warning") %>
        <%= link_to @reviewed, review_metadata_type_metadatum_path(@metadata_type, @metadatum), class: reviewed_button_class, :data => { :'turbo_stream' => '' } %>
      </div>

    </div>

    <hr>

    <div class="row">
      <div class="col-12">
        <%= form_with url: replace_metadata_type_metadatum_path(@metadata_type, @metadatum),
                      method: :patch,
                      class: "d-flex" do |form| %>
          <%= form.label :replace_with, "Replace with id", class: "visually-hidden" %>
          <%= form.number_field :replace_with,
                                class: "form-control me-2",
                                placeholder: "Replace with id",
                                min: 1,
                                step: 1,
                                required: true %>
          <%= form.submit "Replace",
                          class: "btn btn-danger",
                          title: "Replacing destroys the current metadata value and replaces it on all content." %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
