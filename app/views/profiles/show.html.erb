
<h2>Hello <%= @user.name.to_s.humanize %></h2>

<%= bootstrap_form_for(@user, url: "#") do |f| %>
  <div class="field">
    <%= f.email_field :email, disabled: true %>
  </div>

  <div class="field">
    <%= f.text_field :name, disabled: true %>
  </div>

  <div class="field">
    <%= f.text_field :role, disabled: true %>
  </div>
<% end %>


<br />
<%= link_to "Edit Information / Change Password", edit_user_registration_path, :class => "btn btn-warning mb-3"%>

